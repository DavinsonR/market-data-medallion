# PostgreSQL connection string; the local dev default below matches db/migrations (trust auth, no password).
DATABASE_URL=postgresql://mdm@localhost:5433/mdm
# Hosted alternative (Supabase pooler) as used by the daily GitHub Actions workflow:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Tiingo API key for SPY/QQQ daily prices (free tier at https://www.tiingo.com); equities are skipped with a warning if unset.
TIINGO_API_KEY=

# Supabase REST URL + anon key, used only by the daily keep-alive ping that prevents free-tier project pausing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
